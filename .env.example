# Frontend: apenas chave publicável/anon
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_chave_publicavel

# Apenas scripts locais/servidor. NUNCA colocar no navegador ou GitHub.
SUPABASE_SERVICE_ROLE_KEY=sua_chave_secreta

# Supabase Edge Functions de e-mail.
RESEND_API_KEY=re_sua_chave_resend
RESEND_FROM_EMAIL=Nexus Core <alertas@seu-dominio.com>

# Asaas: somente secrets das Edge Functions.
ASAAS_API_KEY=sua_chave_asaas
ASAAS_WEBHOOK_TOKEN=seu_token_exclusivo_de_webhook
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3

# URL pública usada em links de primeiro acesso e recuperação.
# Em preview pode apontar para a branch; em produção deve apontar para o domínio oficial.
NEXUS_PUBLIC_URL=https://nexus-core.seu-dominio.com
