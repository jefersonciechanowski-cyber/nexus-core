# Supabase Edge Functions de e-mail.
RESEND_API_KEY=re_sua_chave_resend
RESEND_FROM_EMAIL=Nexus Core <alertas@seu-dominio.com>

# Stripe: provedor padrão das novas contratações. Somente Edge Functions.
STRIPE_SECRET_KEY=sk_test_sua_chave_stripe
STRIPE_WEBHOOK_SECRET=whsec_seu_segredo_de_webhook

# Asaas: legado/histórico do PR #40. Manter somente enquanto houver integrações antigas ativas.
ASAAS_API_KEY=sua_chave_asaas
ASAAS_WEBHOOK_TOKEN=seu_token_exclusivo_de_webhook
