# Frontend: apenas chave publicável. Pode ficar no navegador quando RLS estiver ativo.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_chave_publicavel

# Apenas scripts locais/servidor. NUNCA colocar no navegador ou GitHub.
SUPABASE_SERVICE_ROLE_KEY=sua_chave_secreta

# Nexus AI Core. Segredos somente no servidor/Edge Function.
NEXUS_AI_ENABLED=false
NEXUS_AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=sk_sua_chave_openai_server_side

# E-mail de onboarding comercial / primeiro acesso (Brevo).
BREVO_API_KEY=xkeysib_sua_chave_brevo
BREVO_FROM_EMAIL=acesso@seu-dominio-verificado.com

# Alertas preventivos do SST Controle (Resend).
RESEND_API_KEY=re_sua_chave_resend
RESEND_FROM_EMAIL=alertas@seu-dominio-verificado.com

# Stripe.
# Sandbox durante testes:
STRIPE_SECRET_KEY=sk_test_sua_chave_stripe
# Produção: substituir por sk_live_... somente após configurar o webhook live.
STRIPE_WEBHOOK_SECRET=whsec_seu_segredo_do_endpoint_correspondente

# URL pública canônica do Nexus Core.
# Sandbox/preview pode usar a URL da branch.
# Produção deve usar o domínio oficial (preferencial) ou, temporariamente,
# o endereço estável da main no Cloudflare Workers.
NEXUS_PUBLIC_URL=https://nexus.seu-dominio.com

# Asaas foi desativado para novas vendas no PR #41.
# As variáveis abaixo não são necessárias para o fluxo comercial atual.
# Manter somente se houver necessidade operacional de consultar integração legada.
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_API_BASE_URL=https://api.asaas.com/v3
